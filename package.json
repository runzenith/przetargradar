{
  "name": "przetargradar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,green,magenta \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsup && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/src/seed.ts",
    "sync": "tsx apps/worker/src/cli.ts",
    "test": "vitest run",
    "test:integration": "tsx scripts/run-integration.ts",
    "test:e2e": "playwright test",
    "test:live": "tsx scripts/check-bzp.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@google/genai": "3.0.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.4.1",
    "@tanstack/react-query": "^5.90.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "6.1.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "5.3.8",
    "fastify": "5.12.8",
    "groq-sdk": "^0.37.0",
    "html-to-text": "^9.0.5",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.2",
    "pino": "^10.1.0",
    "prisma": "6.19.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/html-to-text": "^9.0.4",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
